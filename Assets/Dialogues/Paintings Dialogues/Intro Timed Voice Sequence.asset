  voiceClip: {fileID: 8300000, guid: 9b8019e334cba92488084e4d14f8ab64, type: 3}
  lines:
  - characterName: ...
    text: You came back.
    startTime: 0
    endTime: 2.5
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: You
    text: "\u2026What?"
    startTime: 4
    endTime: 6.5
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: ...
    text: Never mind.
    startTime: 7.5
    endTime: 9
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Georgie
    text: "Don\u2019t be alarmed."
    startTime: 9.5
    endTime: 11.5
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Georgie
    text: "My name is Georgie, and I\u2019m here to guide you."
    startTime: 12
    endTime: 16
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Georgie
    text: This museum is unfinished. And so are the paintings inside it.
    startTime: 16.5
    endTime: 21.6
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Georgie
    text: "Restore them\u2026 and the truth will return with them."
    startTime: 22
    endTime: 25.5
    fadeIn: 0.25
    fadeOut: 0.25
