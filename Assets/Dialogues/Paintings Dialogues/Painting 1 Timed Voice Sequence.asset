  m_Script: {fileID: 11500000, guid: 8e64a84a6c1b496e9d878d241c45b38f, type: 3}
  m_Name: Painting 1 Timed Voice Sequence
  m_EditorClassIdentifier: Assembly-CSharp::Level.UI.VoicedDialogueSequence
  voiceClip: {fileID: 8300000, guid: 818abab3c70ed9440a6e26ed0123634a, type: 3}
  lines:
  - characterName: Georgie
    text: This painting is called The Mother.
    startTime: 2
    endTime: 5
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Georgie
    text: She was the center of his world. Everything he built began with her.
    startTime: 6
    endTime: 12
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: You
    text: What does she do?
    startTime: 12
    endTime: 14
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Georgie
    text: She painted memories. He preserved them. They thought that would last forever.
    startTime: 14
    endTime: 20.5
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Georgie
    text: Sometimes love can hold on too tightly.
    startTime: 22
    endTime: 26
    fadeIn: 0.25
    fadeOut: 0.25
