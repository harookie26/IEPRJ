  voiceClip: {fileID: 8300000, guid: 8286efefb83ae8949ab364ab14d22fa2, type: 3}
  lines:
  - characterName: Georgie
    text: This painting is called The Turning
    startTime: 0
    endTime: 4
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Miguel
    text: Tell me the truth.
    startTime: 4
    endTime: 5
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Elena
    text: I already have.
    startTime: 5
    endTime: 6.75
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Miguel
    text: Then why does it feel like you're hiding something?
    startTime: 7
    endTime: 10
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Elena
    text: Because you're not listening anymore.
    startTime: 10
    endTime: 14
    fadeIn: 0.25
    fadeOut: 0.25
