  m_Script: {fileID: 11500000, guid: 8e64a84a6c1b496e9d878d241c45b38f, type: 3}
  m_Name: Painting 4 Timed Voice Sequence
  m_EditorClassIdentifier: Assembly-CSharp::Level.UI.VoicedDialogueSequence
  voiceClip: {fileID: 8300000, guid: 3dd5e02f8cd7d76478aa9a2733ba0514, type: 3}
  lines:
  - characterName: Georgie
    text: This painting is called The Silenced.
    startTime: 1
    endTime: 3.5
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Georgie
    text: Some memories fight to stay buried.
    startTime: 4
    endTime: 7
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Elena
    text: You're scaring me.
    startTime: 7
    endTime: 9
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Miguel
    text: Stop.
    startTime: 9.5
    endTime: 11
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Elena
    text: Please look at me.
    startTime: 11
    endTime: 18
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Georgie
    text: "The fragments are whole again. Let\u2019s go back to the Main gallery.
      Now the museum can show what really happened."
    startTime: 21
    endTime: 25
    fadeIn: 0.25
    fadeOut: 0.25
