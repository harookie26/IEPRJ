MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8e64a84a6c1b496e9d878d241c45b38f, type: 3}
  m_Name: CorruptedCutscene1
  m_EditorClassIdentifier: Assembly-CSharp::Level.UI.VoicedDialogueSequence
  voiceClip: {fileID: 8300000, guid: 6aa5e894cac5ee742b54c6fbaa10415d, type: 3}
  lines:
  - characterName: Georgie
    text: I see them.
    startTime: 0.21
    endTime: 0.97
    fadeIn: 0.15
    fadeOut: 0.15
  - characterName: Georgie
    text: They weren't meant to look like this.
    startTime: 1.79
    endTime: 3.77
    fadeIn: 0.15
    fadeOut: 0.15
  - characterName: Georgie
    text: Something wounded these memories.
    startTime: 4.67
    endTime: 6.41
    fadeIn: 0.15
    fadeOut: 0.15
  - characterName: Georgie
    text: Grief stained them.
    startTime: 7.33
    endTime: 8.51
    fadeIn: 0.15
    fadeOut: 0.15
  - characterName: Georgie
    text: Anger twisted them.
    startTime: 9.15
    endTime: 10.19
    fadeIn: 0.15
    fadeOut: 0.15
  - characterName: Georgie
    text: When the museum broke, the memories broke with it.
    startTime: 10.93
    endTime: 14.05
    fadeIn: 0.15
    fadeOut: 0.15
  - characterName: Georgie
    text: Now they're scattered throughout these halls.
    startTime: 14.87
    endTime: 16.91
    fadeIn: 0.15
    fadeOut: 0.15
  - characterName: Georgie
    text: Hidden. Forgotten.
    startTime: 17.49
    endTime: 19.05
    fadeIn: 0.15
    fadeOut: 0.15
  - characterName: Georgie
    text: Find and restore them one by one...
    startTime: 19.71
    endTime: 22.15
    fadeIn: 0.15
    fadeOut: 0.15
  - characterName: Georgie
    text: And they'll tell you what this museum is trying to forget.
    startTime: 22.83
    endTime: 25.85
    fadeIn: 0.15
    fadeOut: 0.15
