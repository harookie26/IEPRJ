MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8e64a84a6c1b496e9d878d241c45b38f, type: 3}
  m_Name: CorruptedCutscene1
  m_EditorClassIdentifier: Assembly-CSharp::Level.UI.VoicedDialogueSequence
  voiceClip: {fileID: 0}
  lines:
  - characterName: Georgie
    text: I see them.
    startTime: 0
    endTime: 2
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Georgie
    text: They weren't meant to look like this.
    startTime: 2.25
    endTime: 5.25
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Georgie
    text: Something wounded these memories.
    startTime: 5.5
    endTime: 8.5
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Georgie
    text: Grief stained them.
    startTime: 8.75
    endTime: 11
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Georgie
    text: Anger twisted them.
    startTime: 11.25
    endTime: 13.5
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Georgie
    text: When the museum broke, the memories broke with it.
    startTime: 13.75
    endTime: 17
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Georgie
    text: Now they're scattered throughout these halls.
    startTime: 17.25
    endTime: 20
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Georgie
    text: Hidden. Forgotten.
    startTime: 20.25
    endTime: 22
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Georgie
    text: Find and restore them one by one...
    startTime: 22.25
    endTime: 24.5
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Georgie
    text: And they'll tell you what this museum is trying to forget.
    startTime: 24.75
    endTime: 28
    fadeIn: 0.25
    fadeOut: 0.25
