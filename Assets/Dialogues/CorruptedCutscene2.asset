  m_Script: {fileID: 11500000, guid: 8e64a84a6c1b496e9d878d241c45b38f, type: 3}
  m_Name: CorruptedCutscene2
  m_EditorClassIdentifier: Assembly-CSharp::Level.UI.VoicedDialogueSequence
  voiceClip: {fileID: 0}
  lines:
  - characterName: Georgie
    text: There, that's how the painting was meant to look.
    startTime: 0
    endTime: 3.75
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Georgie
    text: Every corrupted painting can be restored. Find the other four paintings.
    startTime: 4
    endTime: 8.75
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Georgie
    text: And every one you restore changes this.
    startTime: 9
    endTime: 11
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Georgie
    text: The image isn't complete yet.
    startTime: 11.25
    endTime: 14.75
    fadeIn: 0.25
    fadeOut: 0.25
  - characterName: Georgie
    text: Piece by piece, the truth will reveal itself.
    startTime: 15.25
    endTime: 18.5
    fadeIn: 0.25
    fadeOut: 0.25
